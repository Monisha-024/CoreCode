# ---------------------------------------------------------------------------
# Copy this file to .env (or export these as real environment variables)
# before running the backend. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# MySQL
DB_URL=jdbc:mysql://localhost:3306/devassistant?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT - use a long random string (32+ characters) in real deployments
JWT_SECRET=replace-this-with-a-long-random-secret-string-please
JWT_EXPIRATION_MS=86400000

# Gemini API - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# GitHub - a Personal Access Token with "repo" (read) scope
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_API_BASE_URL=https://api.github.com

# CORS - origins allowed to call the API (the frontend's URL)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

SERVER_PORT=8080
UPLOAD_DIR=uploads/policies
